# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg2://claimtrace:claimtrace@localhost:5432/claimtrace
STORAGE_ROOT=./storage
APP_ENV=development

# Required for LLM-backed reasoning (app/llm/gemini_provider.py). Leave
# unset to use the Investigation Engine with reasoning calls disabled —
# they'll fail with a clear error only when actually invoked (i.e. when
# evidence exists). Get a free-tier key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Shared fallback output-token budget for any Gemini call that doesn't
# set its own per-call override (the main investigation answer, and
# vision's image descriptions -- NOT event extraction, which already
# uses its own larger, hardcoded budget for its JSON output). Raise this
# if investigation answers keep getting cut off mid-sentence; see
# app/config.py's own docstring for the full reasoning.
GEMINI_MAX_OUTPUT_TOKENS=2048

# Phase W2.3 (Multimodal Image Understanding): AI-generated visual
# descriptions of preserved images, via app/vision/process_pending.py.
# Opt-in and OFF by default -- OCR and text investigations above are
# unaffected either way. Set to true only after confirming the
# configured GEMINI_MODEL actually accepts image input (see
# app/vision/gemini_vision.py's own docstring); this application makes
# no such claim on its own.
VISION_PROCESSING_ENABLED=false
# Largest image (in bytes) this process will ever attach to a Gemini
# request -- independent of, and smaller than, the limit for what gets
# preserved/stored at all (see app/ingestion/image_validation.py).
VISION_MAX_IMAGE_BYTES=8388608
